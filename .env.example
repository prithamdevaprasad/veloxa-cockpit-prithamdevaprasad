# Copy to .env (never committed) and adjust. docker compose reads .env automatically.

# Required: the extracted release-pack folder (the folder that contains Day1_Mon_16Nov).
# Use the full path. The data is mounted read-only and is never copied into the repository.
VELOXA_DATA_PATH=

# Which database the veloxa CLI and `veloxa serve` use (defaults: 127.0.0.1, 5432, veloxa). Compose publishes 55432.
# VELOXA_DB_HOST=127.0.0.1
# VELOXA_DB_PORT=55432
# VELOXA_DB_NAME=veloxa
# VELOXA_DB_ADMIN_USER=veloxa_admin   # privileged commands only (migrate, init, backup); never for serve

# Tests and the synthetic demo: an administrator DSN used ONLY to create and drop disposable databases.
# VELOXA_TEST_ADMIN_DSN=postgresql://veloxa_admin:<password>@127.0.0.1:55432/postgres

# Optional: local-only database passwords (defaults exist for a localhost-only development database).
# VELOXA_DB_ADMIN_PASSWORD=
# VELOXA_MIGRATOR_PASSWORD=
# VELOXA_APP_PASSWORD=
# VELOXA_INGEST_PASSWORD=
# VELOXA_PROJECTION_PASSWORD=

# LOCAL DEVELOPMENT ONLY. /v1/ask and /v1/briefing are closed (401) unless this fixture is enabled with ALL
# three settings. There is no default identity. Never enable it on a shared or production deployment.
# VELOXA_DEV_AUTH=1
# VELOXA_DEV_TOKEN=            # a random secret of at least 32 characters; send it as "Authorization: Bearer ..."
# VELOXA_DEV_PRINCIPAL=        # the employee ID (from the HR export) the fixture acts as

# Optional: published ports on 127.0.0.1.
# VELOXA_DB_PUBLISH_PORT=55432
# VELOXA_API_PORT=8000

# VELOXA_CLOCK is a TEST-ONLY setting (honoured only with VELOXA_TEST_MODE=1). Do not set it here.

# ---------------------------------------------------------------------------------------------------------------
# Model (C27, governed LLMClient). DEFAULT: DISABLED (DENY_ALL) and agents use facts-only composition.
# NO real model provider is selected or implemented yet, so there is NO API-key variable. A key variable will be
# added only together with an owner-approved provider adapter. The only adapter today is `replay` (recorded
# responses, no network). Token budgets are NOT set here: they are owner-set rows in runtime.llm_budget; with no
# row every model call is refused before it is made.
# VELOXA_MODEL_PROVIDER=            # unset = disabled; the only implemented value is: replay
# VELOXA_MODEL_NAME=
# VELOXA_MODEL_REGION=
# VELOXA_MODEL_STAGES=              # comma-separated, e.g. agent
# VELOXA_MODEL_ALLOWED_CLASSES=     # comma-separated data classes that may be sent, e.g. internal,personal
# VELOXA_MODEL_MAX_ESTIMATE_TOKENS= # per-call ceiling
# VELOXA_MODEL_REPLAY_DIR=          # folder of recorded responses for the replay adapter

# Durable workflows (C26, DBOS): a SEPARATE system database for DBOS state (never the application database).
# VELOXA_WORKFLOW_DATABASE_URL=     # postgresql://<user>:<password>@127.0.0.1:55432/veloxa_dbos

# Gateway (C01). Development defaults; NOT approved production limits.
# VELOXA_RATE_LIMIT_PER_MIN=120
# VELOXA_RATE_LIMIT_EXPENSIVE_PER_MIN=10   # Ask, agent messages, scenarios (proposed pilot value)
# VELOXA_MAX_BODY_BYTES=65536
# VELOXA_TRUSTED_PROXY=                    # the only peer whose X-Forwarded-For is trusted
# VELOXA_METRICS=1                         # expose internal /metrics (off by default)

# Backups and restore drills (C31): PostgreSQL client tools >= 18, a bin directory or docker:<container>.
# VELOXA_PG_TOOLS=docker:veloxa-cockpit-db-1

# Ingestion isolation (C06). Defaults shown; every limit refuses the whole pack.
# VELOXA_INGEST_MAX_FILE_BYTES=52428800
# VELOXA_INGEST_MAX_PACK_BYTES=524288000
# VELOXA_INGEST_MAX_FILES=5000
# VELOXA_INGEST_MAX_UNZIPPED_BYTES=209715200
# VELOXA_INGEST_PARSE_TIMEOUT_S=120

# DBOS retention (C26): proposed 90/180 days, NOT approved. Deletion needs all three, set from an owner decision.
# VELOXA_WORKFLOW_RETENTION_DECISION=
# VELOXA_WORKFLOW_RETENTION_SUCCESS_DAYS=
# VELOXA_WORKFLOW_RETENTION_ERROR_DAYS=
# VELOXA_WORKFLOW_LEGAL_HOLD=            # comma-separated workflow IDs never removed
