# Copy to .env (never committed) and adjust. docker compose reads .env automatically.

# Required: the extracted release-pack folder (the folder that contains Day1_Mon_16Nov).
# Use the full path. The data is mounted read-only and is never copied into the repository.
VELOXA_DATA_PATH=

# Optional: local-only database passwords (defaults exist for a localhost-only development database).
# VELOXA_DB_ADMIN_PASSWORD=
# VELOXA_MIGRATOR_PASSWORD=
# VELOXA_APP_PASSWORD=
# VELOXA_INGEST_PASSWORD=
# VELOXA_PROJECTION_PASSWORD=

# LOCAL DEVELOPMENT ONLY. /v1/ask and /v1/briefing are closed (401) unless this fixture is enabled with ALL
# three settings. There is no default identity. Never enable it on a shared or production deployment.
# VELOXA_DEV_AUTH=1
# VELOXA_DEV_TOKEN=            # a random secret of at least 32 characters; send it as "Authorization: Bearer ..."
# VELOXA_DEV_PRINCIPAL=        # the employee ID (from the HR export) the fixture acts as

# Optional: published ports on 127.0.0.1.
# VELOXA_DB_PUBLISH_PORT=55432
# VELOXA_API_PORT=8000

# VELOXA_CLOCK is a TEST-ONLY setting (honoured only with VELOXA_TEST_MODE=1). Do not set it here.
